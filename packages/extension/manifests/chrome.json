{
  "manifest_version": 3,
  "name": "Password Manager",
  "version": "0.1.0",
  "description": "Self-hosted, end-to-end encrypted password manager.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Password Manager"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
